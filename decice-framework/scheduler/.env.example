# ====================================================================
#  AI Scheduler - Environment Configuration Example
#
#  To use, copy this file to a new file named .env (`cp .env.example .env`)
#  and customize the values as needed. The .env file is gitignored.
# ====================================================================


# --------------------------------------------------------------------
# GENERAL APPLICATION SETTINGS
# --------------------------------------------------------------------
# Environment Setting
# Specifies the runtime environment. Options: "local", "staging", "production"
ENVIRONMENT="local"

# Log Level
# The verbosity of the application's logs.
# Options: "DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"
LOG_LEVEL="INFO"


# --------------------------------------------------------------------
# FastAPI / UVICORN SERVER SETTINGS
# --------------------------------------------------------------------
API_HOST="0.0.0.0"
API_PORT=8030
API_WORKERS=1


# --------------------------------------------------------------------
# FUZZY GATE PARAMETERS
# --------------------------------------------------------------------
# These values control the behavior of the fuzzy logic pre-filtering.
# They have sensible defaults in the code but can be overridden here for tuning.
FUZZY_CPU_WEIGHT=0.35
FUZZY_MEMORY_WEIGHT=0.35
FUZZY_STORAGE_WEIGHT=0.20
FUZZY_NETWORK_WEIGHT=0.0
FUZZY_THRESHOLD=0.25


# --------------------------------------------------------------------
# AI SCHEDULER (PPO) HYPERPARAMETERS
# --------------------------------------------------------------------
# These values control the training and behavior of the reinforcement learning agent.
# It is recommended to keep these as their defaults unless you are actively tuning the model.
AI_ACTOR_LR=0.0003
AI_CRITIC_LR=0.001
AI_GAMMA=0.99
AI_GAE_LAMBDA=0.95
AI_POLICY_CLIP=0.2
AI_ENTROPY_COEFFICIENT=0.01
AI_EPOCHS_PER_UPDATE=10
AI_PPO_BATCH_SIZE=64
AI_REPLAY_BUFFER_CAPACITY=10000


# --------------------------------------------------------------------
# OFFLINE TRAINING SCRIPT PARAMETERS
# --------------------------------------------------------------------
# These values control the behavior of the `scripts/train_ai_scheduler.py` script.
TRAINING_CYCLES=100
MODEL_SAVE_INTERVAL=20

# --------------------------------------------------------------------
# INTERNAL API KEY
# --------------------------------------------------------------------
INTERNAL_API_KEY=very_complex_api_key