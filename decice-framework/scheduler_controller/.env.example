# ====================================================================
#  DECICE Scheduler Controller - Environment Configuration Example
#
#  To use, copy this file to '.env' (`cp .env.example .env`)
# ====================================================================

# -----------------------------------------
# APP ENVIRONMENT
# -----------------------------------------
ENVIRONMENT=local

# -----------------------------------------
# SERVICE HOST CONFIGURATION
# -----------------------------------------
# The host and port on which this Scheduler Controller service will run.
SC_HOST=0.0.0.0
SC_PORT=8020

# -----------------------------------------
# DOWNSTREAM SERVICE LOCATIONS
# -----------------------------------------
# The application will construct the full base URLs from these host/port pairs.
# For Docker Compose, the HOST variables should be the names of the other services.

# Digital Twin Service
DT_SERVICE_HOST=digital-twin
DT_SERVICE_PORT=8010

# Scheduler Service
SCHEDULER_HOST=scheduler
SCHEDULER_PORT=8030

# -----------------------------------------
# INTERNAL API KEY
# -----------------------------------------
INTERNAL_API_KEY=very_complex_api_key