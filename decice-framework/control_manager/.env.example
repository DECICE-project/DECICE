# ===============================================================
#  DECICE Control Manager - Environment Configuration Example
#
#  To use, copy this file to a new file named .env:
#  cp .env.example .env
#
#  Then, you can customize the values in .env as needed.
#  The .env file is gitignored and should NOT be committed.
# ===============================================================

# Application Environment
# Set to 'development' for local work, 'production' for deployments.
ENVIRONMENT=local

# PostgreSQL Credentials
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=userdb

# Application Connection Strings
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
REDIS_URL=redis://redis:6379/0

# Security & JWT Settings
# The duration (in seconds) for a user session stored in Redis.
SESSION_EXPIRE_SECONDS=3600

# A secure, 64-character hex string (representing 32 random bytes) for signing JWTs.
# A default key is provided here for local development convenience.
# IMPORTANT: For production, this MUST be replaced with a securely generated secret.
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7

# The algorithm to use for JWT signing.
JWT_ALGORITHM=HS256

# The lifespan (in minutes) of a JWT access token.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Settings
# For local development, '*' is permissive and convenient.
# For production, this should be restricted to the specific frontend domain.
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=True

# -----------------------------------------
# DOWNSTREAM SERVICE LOCATIONS
# -----------------------------------------
DT_SERVICE_HOST=digital-twin
DT_SERVICE_PORT=8010
PROMQL_WRAPPER_HOST=prometheus-json-wrapper
PROMQL_WRAPPER_PORT=8050
PSGC_HOST=psgc
PSGC_PORT=8040
SCHEDULER_HOST=ai-scheduler
SCHEDULER_PORT=8030
SC_HOST=scheduler-controller
SC_PORT=8020

# -----------------------------------------
# OBSERVABILITY (OpenTelemetry)
# -----------------------------------------
OTEL_SERVICE_NAME="psgc"
# The endpoint for the OTLP collector (e.g., Grafana Agent, Jaeger Collector)
# Leave blank to disable OTel and fall back to console logging.
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT="http://localhost:4318/v1/logs"

# Optional headers for authentication, comma-separated key=value pairs
# Example for Grafana Cloud: "Authorization=Bearer your_token_here"
OTEL_EXPORTER_OTLP_LOGS_HEADERS=""

# -----------------------------------------
# INTERNAL API KEY
# -----------------------------------------
INTERNAL_API_KEY=XuTThABy4NY__E7N3PbyZGs6_0FNz_l3xr204DVz_yB8FYrYwdPfVmq9-oLLtIL7D0b0dpcTEdvOkIlaTvcTzw