# ====================================================================
#  DECICE Framework - Unified Environment Configuration Example
#
#  This file defines all environment variables needed to run the
#  complete multi-service stack via the root docker-compose.yml.
# 
#  To use, copy this file to a new file named .env:
#  cp .env.example .env
#
#  Then, you can customize the values in .env as needed.
#  The .env file is gitignored and should NOT be committed.
# ====================================================================

# =========================================
# APP ENVIRONMENT
# =========================================
ENVIRONMENT=local


# =========================================
# LOG LEVEL
# =========================================
LOG_LEVEL=INFO


# ====================================================================
# SERVICE-SPECIFIC CONFIGURATION
# ====================================================================

# ======================= CONTROL MANAGER =======================
CM_HOST=0.0.0.0
CM_PORT=8000

# PostgreSQL Credentials
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=userdb

# Database & Cache URLs
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379/0
SESSION_EXPIRE_SECONDS=1800

# Downstream Services for Control Manager
SC_SERVICE_HOST=localhost
SC_SERVICE_PORT=8020
PSGC_SERVICE_HOST=localhost
PSGC_SERVICE_PORT=8040

# Security & JWT Settings
JWT_SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=*
CORS_ALLOWED_METHODS=*
CORS_ALLOWED_HEADERS=*
CORS_ALLOW_CREDENTIALS=True


# =================== SCHEDULER CONTROLLER ===================
SC_HOST=0.0.0.0
SC_PORT=8020

# Downstream Services for Scheduler Controller
DT_SERVICE_HOST=localhost
DT_SERVICE_PORT=8010

SCHEDULER_SERVICE_HOST=localhost
SCHEDULER_SERVICE_PORT=8030


# =================== PROMQL JSON WRAPPER ===================
PROMQL_WRAPPER_HOST=0.0.0.0
PROMQL_WRAPPER_PORT=8050

# Downstream Services for PROMQL JSON Wrapper
DT_SERVICE_HOST=localhost
DT_SERVICE_PORT=8010

PROMETHEUS_HOST=localhost
PROMETHEUS_PORT=9090

# Services
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

AUTO_UPDATE_DT_ENABLED=false
AUTO_UPDATE_DT_FREQUENCY_SECONDS=30.0

# A JSON-formatted list of strings for power consumption queries.
# Example: POWER_CONSUMPTION_PROMQL_QUERIES='["my_query_1", "my_query_2"]'
POWER_CONSUMPTION_PROMQL_QUERIES='[]'


# ========================== AI SCHEDULER ==========================
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8030
API_WORKERS=1
# NOTE: All other AI hyperparameters have defaults set in the AppSettings class.
# Add them here only if you need to override them for development.


# ========================== PSGC ==========================
PSGC_HOST=0.0.0.0
PSGC_PORT=8040

# Downstream Services for PSGC
CM_SERVICE_HOST=0.0.0.0
CM_SERVICE_PORT=8000

# MinIO Credentials & Config
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=minio
MINIO_PORT=9090
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false

# MinIO Webhook Configuration
MINIO_SERVER_URL=http://minio:9000
MINIO_NOTIFY_WEBHOOK_ENABLE_psgc=on
MINIO_NOTIFY_WEBHOOK_ENDPOINT_psgc=http://psgc:8040/webhooks/minio

# Kubernetes Settings
K8S_API_SERVER_IP=192.168.49.2

# Slurm Client configuration
SLURM_CLIENT_HOST=host.docker.internal
SLURM_CLIENT_PORT=8060


# ========================== Digital Twin ==========================
DT_HOST=0.0.0.0
DT_PORT=8010

# Downstream Services for Digital Twin
SC_SERVICE=localhost
SC_PORT=8020

PROMQL_WRAPPER_SERVICE=localhost
PROMQL_WRAPPER_PORT=8050

# InfluxDB Configuration
INFLUXDB_ORG=decice
INFLUXDB_BUCKET=cluster_snapshot
INFLUXDB_USER=influx_user
INFLUXDB_PASSWORD=a_secure_password
INFLUXDB_TOKEN=my_super_secret_admin_token
INFLUXDB_URL=http://localhost:8086

# ========================== KUBERNETES LOCAL DEV CONFIGURATION ==========================
# Run `grep "certificate-authority" ~/.kube/config` to see the path your config expects.
# Copy the directory part (e.g., /home/appuser/.minikube) here.
KUBE_CERT_MOUNT_PATH=/home/appuser/.minikube

# ========================== INTERNAL_API_KEY ==========================
INTERNAL_API_KEY=very_complex_api_key