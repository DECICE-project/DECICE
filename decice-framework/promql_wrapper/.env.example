# ====================================================================
#  Prometheus JSON Wrapper - Environment Configuration Example
#
#  To use, copy this file to '.env' (`cp .env.example .env`)
# ====================================================================

# -----------------------------------------
# APP ENVIRONMENT
# -----------------------------------------
ENVIRONMENT=local

# -----------------------------------------
# SERVICE CONFIGURATION
# -----------------------------------------
LOG_LEVEL="INFO"

# -----------------------------------------
# SERVICE HOST/PORT
# -----------------------------------------
PROMQL_WRAPPER_HOST=0.0.0.0
PROMQL_WRAPPER_PORT=8050

# -----------------------------------------
# DOWNSTREAM SERVICE LOCATIONS
# -----------------------------------------
# For Docker Compose, these hosts should be the service names.
# For local development, they can be 'localhost'.
DT_SERVICE_HOST=digital-twin
DT_SERVICE_PORT=8010

PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# -----------------------------------------
# BACKGROUND TASK CONFIGURATION
# -----------------------------------------
# To enable the periodic update task, set to 'true'.
AUTO_UPDATE_DT_ENABLED=false
# The frequency (in seconds) of the periodic update.
AUTO_UPDATE_DT_FREQUENCY_SECONDS=10.0

# -----------------------------------------
# INTERNAL API KEY
# -----------------------------------------
INTERNAL_API_KEY=very_complex_api_key

# -----------------------------------------
# CUSTOM PROMETHEUS QUERIES
# -----------------------------------------
# A JSON-formatted list of strings for power consumption queries.
# Example: POWER_CONSUMPTION_PROMQL_QUERIES='["my_query_1", "my_query_2"]'
POWER_CONSUMPTION_PROMQL_QUERIES='["avg_over_time(pdu_node_power_watts[2m])","sum(( turbostat_total{type=\"pkgwatt\"} or DCGM_FI_DEV_POWER_USAGE or integrated_power_mW{statistic=\"power\"}/1000 )) by (nodename)"]'


# -----------------------------------------
# CUSTOM CLUSTER INFO PROMETHEUS QUERY CONFIGURATION
# -----------------------------------------
# You can define one or more custom PromQL queries that the Prometheus JSON Wrapper
# will execute and map into labeled fields within the output JSON (under cluster info).
#
# Each query configuration includes:
#   - field_name:     A unique name for the metric field under the cluster_info of DT output JSON.
#   - promql:         The PromQL expression to execute against Prometheus.
#   - label_key:      The label to map results by (e.g., "instance", "horizon") if omitted or null, values is directly mapped to field_name.
#
# The resulting output JSON will look like:
#  "cluster_info" : {
#   <field_name_1> : {
#     <label_value_1>: <prometheus_value_for_label_value_1>
#     <label_value_2>: <prometheus_value_for_label_value_2>
#    <field_name_2> : <prometheus_value>
#     ...}
#   }
# Example output:
# "cluster_info":{
#   carbon_intensity_prediction{
#     "1h": 152.3,
#     "2h":  144.9
#    },
#   "memory_usage": {
#     node01: 84.2,
#     node02: 79.8
#    }
#   "cluster_power_watts": 1234.5
#   }
#
# You can configure multiple queries by defining a JSON array of objects:
#
# CLUSTER_INFO_QUERIES='[
#   {
#     "field_name": "carbon_intensity_prediction",
#     "promql": "avg by (horizon) (carbon_intensity)",
#     "label_key": "horizon"
#   },
#   {
#     "field_name": "memory_usage",
#     "promql": "100-(node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100)",
#     "label_key": "instance"
#   }
# ]'
#
# IMPORTANT:
# - Use single quotes `'` around the JSON array to avoid shell parsing issues.
# - Ensure the JSON is in a single line (no line breaks).
# - The `label_key` must exist in the Prometheus metric labels for mapping to work.
#

CLUSTER_INFO_QUERIES='[
  {
    "field_name": "carbon_intensity_prediction",
    "promql": "avg by (horizon) (carbon_intensity)",
    "label_key": "horizon"
  },
  {
    "field_name": "cluster_power_watts",
    "promql": "sum(sum((turbostat_total{type=\"pkgwatt\"} or DCGM_FI_DEV_POWER_USAGE  or integrated_power_mW{statistic=\"power\"}/1000 )) by (nodename))",
    "label": null
  },
  {
    "field_name": "total_available_disk_gb",
    "promql": "sum(node_filesystem_avail_bytes{mountpoint=\"/\"})/1_000_000_000"
  },
  {
    "field_name": "pod_count_by_namespace",
    "promql": "count(kube_pod_info{namespace!=\"\"}) by (namespace)",
    "label_key": "namespace"
  }
]'

# -----------------------------------------
# CUSTOM NODE INFO PROMETHEUS QUERY CONFIGURATION
# -----------------------------------------
# You can define one or more custom PromQL queries that the Prometheus JSON Wrapper
# will execute and map directly into the "node_info" section of the Digital Twin output JSON.
#
# Each query configuration includes:
#   - field_name:  A unique name for the metric field under the node_info section.
#   - promql:      The PromQL expression to execute against Prometheus.
#
# Unlike CLUSTER_INFO_QUERIES, no arbitrary label-based grouping is performed here.
# Instead, each PromQL query is EXPECTED TO RETURN RESULTS CONTAINING A "nodename" LABEL,
# whose values MUST MATCH EXACTLY the Kubernetes node names known to the Digital Twin.
#
# This ensures each metric is correctly associated with its corresponding node in the output.
#
# The resulting output JSON will look like:
#
# Example output:
# "node_info": {
#     "anomaly_ae_score": 446952748001263600,
#     "anomaly_tcn_score": 0
#   }
# 
#
# You can configure multiple queries by defining a JSON array of objects:
#
# NODE_INFO_QUERIES='[
#   {
#     "field_name": "cpu_temperature",
#     "promql": "node_hwmon_temp_celsius"
#   },
#   {
#     "field_name": "fan_speed_rpm",
#     "promql": "node_hwmon_fan_speed_rpm"
#   }
# ]'
#
# IMPORTANT:
# - Use single quotes `'` around the JSON array to avoid shell parsing issues.
# - Ensure the JSON is in a single line (no line breaks).
# - Each PromQL query must include a "nodename" label matching Kubernetes node names.
# - If the query does not expose a "nodename" label, join it in PromQL, e.g.:
#     avg(node_cpu_seconds_total) by (nodename)
#

NODE_INFO_QUERIES='[
  {
  "field_name": "anomaly_ae_score", 
  "promql": "label_replace(({__name__=~\"anomaly_ae_.*\"}) * on(pod, namespace) group_left(node) kube_pod_info,\"nodename\", \"$1\", \"node\", \"(.*)\")"  
  },
  {
  "field_name": "anomaly_tcn_score",
  "promql": "label_replace(({__name__=~\"anomaly_tcn_.*\"}) * on(pod, namespace) group_left(node) kube_pod_info,\"nodename\", \"$1\", \"node\", \"(.*)\")"
  },
  { 
  "field_name": "fan_speed_rpm",
  "promql": "label_replace( node_hwmon_fan_rpm * on(pod, namespace) group_left(node) kube_pod_info,\"nodename\", \"$1\", \"node\", \"(.*)\")" 
  },
  {
  "field_name": "cpu_power",
  "promql": "turbostat_total{type=\"pkgwatt\"} or integrated_power{machine_part=~\"VDD_CPU_CV|POM_5V_CPU\",statistic=\"power\"}/1000"
  },
  {
  "field_name": "gpu_power",
  "promql": "integrated_power{machine_part=~\"POM_5V_GPU|VDD_GPU_SOC\",statistic=\"power\"}/1000 or DCGM_FI_DEV_POWER_USAGE"
  },
  {
  "field_name": "gpu_utilization",
  "promql": "gpu_utilization_percentage_Hz{nvidia_gpu=\"load\"} or DCGM_FI_DEV_GPU_UTIL"
  }
  ]'